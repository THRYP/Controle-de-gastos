# Copie este arquivo para .env e ajuste os valores conforme o seu ambiente.

# Chave secreta usada pelo Flask para sessões e mensagens flash.
# Gere uma nova com: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=troque-por-uma-chave-secreta-aleatoria

# Configurações do servidor Flask
FLASK_APP=app.py
FLASK_ENV=development
FLASK_DEBUG=true
FLASK_HOST=127.0.0.1
FLASK_PORT=5000

# Banco de dados SQLite (caminho relativo à raiz do projeto ou absoluto)
DATABASE_PATH=gastos.db

# Limite máximo para upload de extratos (.ofx, .csv, .txt, .pdf) em MB
MAX_CONTENT_LENGTH_MB=10

# Login com Google (OAuth 2.0 / Gmail)
# Crie um ID do cliente OAuth 2.0 (Aplicativo da Web) no Google Cloud Console
# e cadastre a URI de redirecionamento abaixo:
GOOGLE_CLIENT_ID=seu-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=seu-google-client-secret
GOOGLE_REDIRECT_URI=http://127.0.0.1:5000/auth/google/callback
ALLOW_GOOGLE_SIGNUP=true

# Conta inicial do Administrador (criada na inicialização se não houver admin)
ADMIN_NOME=Administrador
ADMIN_EMAIL=admin@seudominio.com
ADMIN_PASSWORD=troque-por-uma-senha-forte
